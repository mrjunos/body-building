# Config web del proyecto Firebase (Consola → Configuración del proyecto → Tus
# apps → App web, o `firebase apps:sdkconfig WEB --project entreno-jj`). No son
# secretos. Copia este archivo a .env y pobla los valores; en CI salen de las
# GitHub Variables del repo.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
